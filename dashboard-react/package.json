{
  "name": "voice-garden-react",
  "private": true,
  "version": "0.1.0",
  "description": "All-in-one voice training recorder and analysis dashboard.",
  "author": "smallfrais-cell",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "app": "node server.mjs",
    "desktop": "electron electron/main.mjs",
    "electron:dev": "concurrently -k -n server,electron \"npm run app\" \"wait-on http://127.0.0.1:5173 && electron electron/main.mjs\"",
    "build": "tsc -b && vite build",
    "build:analyzer:win": "cd .. && uv run --with pyinstaller pyinstaller --clean --onefile --name voice-garden-analyzer --hidden-import parselmouth.praat analyze.py",
    "preview": "vite preview",
    "pack:win": "npm run build && npm run build:analyzer:win && electron-builder --win --x64 --dir",
    "dist:win": "npm run build && npm run build:analyzer:win && electron-builder --win nsis --x64"
  },
  "build": {
    "appId": "com.smallfrais.voicegarden",
    "productName": "Voice Garden",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "appServer.mjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../analyze.py",
        "to": "workspace/analyze.py"
      },
      {
        "from": "../pyproject.toml",
        "to": "workspace/pyproject.toml"
      },
      {
        "from": "../uv.lock",
        "to": "workspace/uv.lock"
      },
      {
        "from": "../recordings.json",
        "to": "workspace/recordings.json"
      },
      {
        "from": "../dist/voice-garden-analyzer.exe",
        "to": "workspace/bin/voice-garden-analyzer.exe"
      },
      {
        "from": "node_modules/@ffmpeg-installer/win32-x64/ffmpeg.exe",
        "to": "workspace/bin/ffmpeg.exe"
      },
      {
        "from": "public",
        "to": "workspace/dashboard-react/public"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Voice Garden"
    }
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@wavesurfer/react": "^1.0.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.6.0",
    "wavesurfer.js": "^7.12.8"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.1",
    "electron": "^37.6.0",
    "electron-builder": "^26.0.12",
    "playwright": "^1.61.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wait-on": "^8.0.4"
  }
}
