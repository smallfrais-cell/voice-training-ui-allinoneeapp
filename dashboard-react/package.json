{
  "name": "voice-garden-react",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "app": "node server.mjs",
    "desktop": "electron electron/main.mjs",
    "electron:dev": "concurrently -k -n server,electron \"npm run app\" \"wait-on http://127.0.0.1:5173 && electron electron/main.mjs\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@wavesurfer/react": "^1.0.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.6.0",
    "wavesurfer.js": "^7.12.8"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.1",
    "electron": "^37.6.0",
    "playwright": "^1.61.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wait-on": "^8.0.4"
  }
}
